# AWS CDK Application Stack - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Required Parameters
# ============================================

# Environment and user labels (short identifiers)
CDK_ENV_LABEL=dev
CDK_USER_LABEL=alice

# AWS Account and Region
CDK_ACCOUNT=123456789012  # Your AWS account ID
CDK_REGION=us-west-2      # AWS region

# VPC Configuration
CDK_VPC_ID=vpc-099149e2d85e01e4b  # VPC ID for deployment

# WAF Configuration
CDK_WAF_WEBACL_ARN=arn:aws:wafv2:us-west-2:123456789012:regional/webacl/example-waf/abc123def456
CDK_WAF_ID=waf-abc123  # Short identifier for WAF (used in DNS)

# Domain Configuration
CDK_DOMAIN_NAME=amazonaws.com  # Base domain name (e.g., amazonaws.com, example.com)

# ============================================
# Optional Parameters
# ============================================

# EC2 Target Instances (comma-separated)
# Leave empty for manual registration via link-ec2-to-alb.sh
CDK_TARGET_INSTANCE_IDS=i-1234567890abcdef0,i-0987654321fedcba0

# ============================================
# Derived Values (Automatically Calculated)
# ============================================

# Deployment ID: ade-{env}-{user}
# Example: ade-dev-alice

# Application URLs (automatically generated):
# Streamlit:  https://streamlit.ade-dev-alice.waf-abc123.amazonaws.com
# JupyterLab: https://jupyter.ade-dev-alice.waf-abc123.amazonaws.com

# Stack Name: ADE-{env}-{user}-App-Stack
# Example: ADE-dev-alice-App-Stack

# ============================================
# Usage Examples
# ============================================

# 1. Source this file:
#    source .env

# 2. Deploy application stack:
#    ./deploy-application-stack.sh

# 3. Register EC2 instances:
#    ./link-ec2-to-alb.sh $CDK_ENV_LABEL $CDK_USER_LABEL $CDK_TARGET_INSTANCE_IDS

# 4. Create Cognito user:
#    python manage-cognito-users.py create $CDK_ENV_LABEL $CDK_USER_LABEL user@example.com

# 5. Validate deployment:
#    ./validate-application-stack.sh $CDK_ENV_LABEL $CDK_USER_LABEL

# ============================================
# Notes
# ============================================

# - WAF WebACL must be created manually via AWS Console before deployment
# - Route53 hosted zone for CDK_DOMAIN_NAME must exist
# - EC2 instances must be deployed via dev_environment_stack first
# - Ensure AWS CLI is configured with valid credentials
# - CDK must be bootstrapped in the target account/region

# ============================================
# Getting Required Values
# ============================================

# Get AWS Account ID:
#   aws sts get-caller-identity --query Account --output text

# List VPCs:
#   aws ec2 describe-vpcs --query "Vpcs[*].[VpcId,Tags[?Key=='Name'].Value|[0]]" --output table

# List EC2 instances from dev_environment_stack:
#   aws cloudformation describe-stacks \
#     --stack-name ADE-dev-alice-Stack \
#     --query "Stacks[0].Outputs[?OutputKey=='InstanceId'].OutputValue" \
#     --output text

# List WAF WebACLs:
#   aws wafv2 list-web-acls --scope REGIONAL --region us-west-2

# List Route53 hosted zones:
#   aws route53 list-hosted-zones --query "HostedZones[*].[Name,Id]" --output table
