# infra/dockerfiles/Dockerfile.postgres-rag
# Dedicated PostgreSQL instance for RAG vector storage with pgvector extension.
# Separate from the orchestrator's postgres to isolate vector search workloads
# (HNSW indexing, cosine similarity scans) from checkpoint/session persistence.
FROM pgvector/pgvector:pg15

# Copy RAG-specific init script
RUN mkdir -p /docker-entrypoint-initdb.d/
COPY ./scripts/deps/init-rag-db.sh /docker-entrypoint-initdb.d/
RUN chown -R postgres /docker-entrypoint-initdb.d/
RUN chmod a+x -R /docker-entrypoint-initdb.d/ /docker-entrypoint-initdb.d/init-rag-db.sh
