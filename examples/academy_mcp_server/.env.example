# Academy MCP Server environment configuration
# Copy to .env and customise as needed.

# Server settings (Pydantic BaseSettings with env_prefix=ACADEMY_)
ACADEMY_PORT=9004
ACADEMY_REDIS_URL=redis://academy_redis:6379/0
ACADEMY_LOG_LEVEL=INFO

# Redis host port (mapped from academy_redis container)
ACADEMY_REDIS_PORT=6384

# Nginx proxy ports
ACADEMY_HTTP_PORT=9020
ACADEMY_HTTPS_PORT=9021

# Tool registration credentials
ADMIN_USER=admin
ADMIN_PASS=admin

# Container engine: docker or podman
# ENGINE=docker
