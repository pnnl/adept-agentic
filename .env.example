SANDBOX_MCP_SERVER_URL=http://sandbox_mcp_server:8082/mcp

# ===== EMSL Sandbox Remote File Relay (Session 63) =====
#
# Enables presigned URL downloads for files generated on the external EMSL sandbox
# (Rocky 9 VM at PNNL). Files stay on EMSL; EC2 stores only metadata in Redis.
#
# Workflow:
#   1. Agent calls emsl_sandbox_execute_code via MCP tunnel
#   2. EMSL sandbox runs code, generates files (CSVs, plots, Gurobi outputs)
#   3. Subprocess backend returns {generated_files: [...paths...], plots: [...]}
#   4. MCP response travels back through SSH tunnel to EC2
#   5. graph_builder._register_emsl_remote_files() converts EMSL absolute paths
#      to nginx URLs and writes metadata to EC2 Redis (storage_type="remote")
#   6. Agent calls GeneratePresignedURL → user gets download link
#   7. User clicks link → EC2 validates HMAC → fetches from EMSL nginx → streams to browser
#
# File registration happens on EC2 (graph_builder intercepts tool output).
# The EMSL sandbox's own register_generated_file() silently fails because
# it tries to reach orchestration_service:8084 which doesn't exist on EMSL.
#
# Security: EMSL nginx /files/ endpoint requires X-Sandbox-Token header
# (defense-in-depth: IP allowlist + shared secret + disabled autoindex).
# See: examples/emsl_sandbox/docs/EMSL_DEPLOYMENT_OPERATIONS_GUIDE.md §1.5a-1.5b
#
# Base URL for the EMSL sandbox nginx file server (via SSH reverse tunnel + socat relay).
# 172.17.0.1 = Docker host IP; 9081 = socat relay port on EC2 forwarding to EMSL tunnel.
# Leave empty/unset if EMSL sandbox is not connected.
EMSL_FILES_BASE_URL=
# EMSL_FILES_BASE_URL=http://172.17.0.1:9081/files
#
# Shared secret token for authenticating file download requests to the EMSL sandbox
# nginx /files/ endpoint. Must match SANDBOX_FILES_TOKEN on the EMSL VM side.
# Generate with: openssl rand -hex 32
# Leave empty if EMSL sandbox is not connected.
EMSL_SANDBOX_FILES_TOKEN=
#
# EMSL sandbox HTTPS/TLS configuration (Session 64)
# When the EMSL sandbox uses HTTPS (local CA-signed cert), set these variables
# to enable TLS verification on the EC2 side.
#
# Path to the EMSL sandbox CA certificate inside the orchestration_service container.
# The ca.crt file is generated on the EMSL side (make generate-certs) and mounted
# into the container via docker-compose.core.yaml volume bind.
# Leave empty if EMSL sandbox is HTTP-only.
EMSL_SANDBOX_CA_CERT=/usr/local/share/ca-certificates/emsl-sandbox-ca.crt
#
# SSL verification mode for the remote file relay (httpx.AsyncClient verify=).
# Priority: EMSL_SANDBOX_CA_CERT (if set and exists) > this setting > default (true).
# Set to "false" as an escape hatch to disable all TLS verification.
EMSL_SANDBOX_SSL_VERIFY=true

# ===== Orchestration Service Configuration =====
# Number of Uvicorn workers for the Orchestration Service
# Recommended: 4 workers for production (balances throughput and resource usage)
# - 1 worker: Default, single-threaded (not recommended for production)
# - 2 workers: Light load testing
# - 4 workers: Production default (handles 4 concurrent requests)
# - 8+ workers: High-load scenarios (requires increased database pool size)
# NOTE: Database connection pool automatically scales (min_size=4, max_size=16 for 4 workers)
ORCHESTRATION_UVICORN_WORKERS=4

# ===== Gateway Registry Configuration =====
# The Gateway Registry is the central service discovery component for A2A federation.
# It stores peer gateway registrations and provides health-checking endpoints.

# ALLOWED_PEER_CIDRS - Zero-trust CIDR allowlist for A2A peer gateway registration
# By default, private IPs (RFC 1918) are BLOCKED to prevent SSRF/service-discovery poisoning.
# You MUST explicitly declare which private network ranges contain trusted peer gateways.
#
# Format: Comma-separated CIDR ranges (IPv4 and/or IPv6)
# Examples:
#   Single subnet:   ALLOWED_PEER_CIDRS=10.16.17.0/24
#   Multiple subnets: ALLOWED_PEER_CIDRS=10.16.17.0/24,10.15.49.0/24
#   Entire VPC:      ALLOWED_PEER_CIDRS=10.0.0.0/8
#   Mixed cloud:     ALLOWED_PEER_CIDRS=10.16.17.0/24,172.31.0.0/16
#
# Security notes:
#   - Public IPs are always allowed (no allowlist needed)
#   - Loopback (127.x.x.x), link-local (169.254.x.x), and AWS metadata (169.254.169.254)
#     are always blocked regardless of this setting
#   - Use the narrowest CIDR ranges possible (prefer /24 over /8)
#   - This does NOT control who can call the API (that's Keycloak RBAC) - it controls
#     which IP ranges can appear in the public_url field of a gateway registration
ALLOWED_PEER_CIDRS=

# ===== A2A JWKS Federation Configuration =====
#
# A2A_TRUSTED_PEER_JWKS_URLS - Trusted peer Keycloak JWKS endpoints for cross-gateway
# JWT token validation. When a token's signing key (kid) is not found in the local
# Keycloak's JWKS, the Agent Gateway will try fetching keys from these peer endpoints.
#
# Why this is needed:
#   Each ADEPT deployment has its own Keycloak instance with unique RSA signing keys.
#   When Gateway A receives a token issued by Gateway B's Keycloak, the local JWKS
#   won't contain the matching key. This setting tells the gateway where to find
#   the peer's signing keys for cross-instance A2A communication.
#
# Format: Comma-separated full JWKS endpoint URLs (must be reachable from the
#   agent_gateway container). Use the peer's nginx-proxied path, not internal
#   Docker service names (which are only reachable within the same Docker network).
#
# Examples:
#   Single peer:   A2A_TRUSTED_PEER_JWKS_URLS=https://10.15.49.44/realms/master/protocol/openid-connect/certs
#   Multiple peers: A2A_TRUSTED_PEER_JWKS_URLS=https://10.15.49.44/realms/master/protocol/openid-connect/certs,https://10.20.30.40/realms/master/protocol/openid-connect/certs
#
# Security notes:
#   - Only add JWKS URLs from deployments you explicitly trust
#   - The gateway verifies token signatures against the peer's public keys (read-only)
#   - No secrets are exchanged - only public JWKS keys are fetched
#   - Use HTTPS endpoints where possible (self-signed certs are accepted)
#   - If left empty, only tokens signed by the local Keycloak are accepted
A2A_TRUSTED_PEER_JWKS_URLS=

# A2A_PEER_GATEWAY_URL - HTTPS URL of the peer gateway for cross-host E2E tests
# Used by: tests/e2e/test_a2a_cross_host_responses_api.py
# Format: HTTPS base URL (no trailing slash, no /v1 suffix)
# Example: https://10.15.49.44
# If empty, cross-host tests are skipped (local-only tests still run)
A2A_PEER_GATEWAY_URL=

# ===== Sandbox Execution Timeout Configuration =====
# Configurable timeout settings for code execution in sandbox
# NOTE: For COBRApy/SBML operations, increase these values significantly
# COBRApy recommended: DEFAULT=120, MAX=1800 (30 min), DOWNLOAD=300
SANDBOX_DEFAULT_TIMEOUT=30       # Default timeout in seconds (30s) - increase to 120+ for COBRApy
SANDBOX_MAX_TIMEOUT=600          # Maximum allowed timeout (10 minutes) - increase to 1800+ for complex models
SANDBOX_DOWNLOAD_TIMEOUT=120     # Special timeout for download operations (2 minutes)

# Multi-tenant concurrency settings
SANDBOX_UVICORN_WORKERS=4        # HTTP workers for parallel request handling (default: 1)
SANDBOX_MAX_CONCURRENT_EXECUTIONS=5  # Max concurrent subprocess executions per worker (default: 5)
SANDBOX_MAX_CONCURRENT_DIND=3    # Max concurrent Docker-in-Docker containers per worker (default: 3)

# Subprocess identity (Gurobi token server auth, Task #726)
# The Gurobi token server validates the OS username (whoami) of the connecting process,
# NOT the USERNAME field in gurobi.lic. Set these to the username authorized on the
# token server so os.setuid() switches the subprocess identity before code execution.
# When empty, subprocess runs as the container's default user (no identity switch).
# NOTE: UID must not conflict with appuser (1200) in the base image.
# GID defaults to 1200 (appgroup) so exec user can write to shared volume.
SANDBOX_EXEC_USER=
SANDBOX_EXEC_UID=1500
SANDBOX_EXEC_GID=1200

# Gurobi Token Server (opt-in — leave empty/unset to disable Gurobi support)
# The sandbox subprocess discovers the license file at runtime via path search:
#   1. /app/data/gurobi.lic (bind mount or compose override)
#   2. /app/data/uploaded_files/gurobi.lic (shared volume — simplest approach)
#   3. /opt/gurobi/gurobi.lic (standard install path)
# Place your license file at data/uploaded_files/gurobi.lic to enable without config changes.
# GRB_LICENSE_FILE tells the entrypoint where to validate (not passed to subprocess).
GRB_LICENSE_FILE=
# Token server DNS — injected into container /etc/hosts via extra_hosts.
# Set to your Gurobi token server hostname and IP for DNS resolution inside container.
GRB_TOKEN_SERVER_HOST=
GRB_TOKEN_SERVER_IP=
GRB_TOKEN_SERVER_PORT=

# ===== Tool Execution Configuration =====
# Controls how tools are executed by the Tool Execution Factory
#
# TOOL_EXECUTION_WAIT_FOR_COMPLETION:
#   - "false" (default): Asynchronous execution with enhanced ToolMessage format
#     * Returns complete ToolMessage immediately (OpenAI Response API compatible)
#     * Non-blocking execution prevents UI freezing during long-running tools (5-10 min)
#     * ToolMessage includes: human-readable content, task_id, status, session context
#     * Agent polls via CheckTaskStatus tool for results
#     * Recommended for production use to prevent UI blocking
#
#   - "true": Synchronous execution - waits for actual tool results
#     * Blocks conversation turn until tool completes
#     * Returns actual results in ToolMessage
#     * WARNING: Will block UI for long-running operations
#     * Use only for specific cases requiring immediate results
#
TOOL_EXECUTION_WAIT_FOR_COMPLETION=false

# TOOL_EXECUTION_SYNC_OVERRIDES:
#   Comma-separated list of tool names to force synchronous execution.
#   Provides fine-grained control over tool execution mode without global override.
#
#   HOW IT WORKS:
#   - The framework uses a two-tier classification system:
#     * Tier 1 (Hardcoded Whitelist): Planning tools and RAG tools ALWAYS execute synchronously
#       - Planning: CreateMultiAgentSession, GeneratePlanForMultiAgentTask, ExecuteApprovedPlan, TerminateMultiAgentSession
#       - RAG: process_uploaded_file, query_file_content
#       - These tools return immediate results required for workflow progression
#     * Tier 2 (User Overrides): Additional tools can be forced synchronous via this setting
#       - Useful for file processing tools where execution time varies by use case
#       - Example: video_processing_tool, gitxray_tool, file_processor_tool, zip_processor_tool
#
#   WHEN TO USE:
#   - File processing tools: Force sync when you need immediate confirmation (e.g., small files)
#   - Quick operations: Tools that typically complete in <10 seconds but are async by default
#   - Debugging: Force sync execution to simplify testing and log analysis
#
#   WHEN NOT TO USE:
#   - Long-running tools: BLAST, AlphaFold, Nextflow pipelines (keep async for better UX)
#   - Planning/RAG tools: Already handled by Tier 1 whitelist (no override needed)
#   - Production workloads: Prefer async execution to prevent conversation blocking
#
#   EXAMPLES:
#   # Force video processing to return actual transcript (blocks until complete)
#   TOOL_EXECUTION_SYNC_OVERRIDES="video_processing_tool"
#
#   # Force multiple file processing tools to execute synchronously
#   TOOL_EXECUTION_SYNC_OVERRIDES="video_processing_tool,gitxray_tool,file_processor_tool"
#
#   # No overrides (default) - use framework's built-in classification
#   TOOL_EXECUTION_SYNC_OVERRIDES=""
#
#   NOTES:
#   - Overrides apply system-wide for all users
#   - Use sparingly - async execution provides better UX for long-running tools
#   - Tool names are case-sensitive and must match exactly
#   - Planning tools (CreateMultiAgentSession, etc.) are ALWAYS synchronous regardless of this setting
#   - RAG tools (process_uploaded_file, query_file_content) are ALWAYS synchronous regardless of this setting
#
TOOL_EXECUTION_SYNC_OVERRIDES=""

# Sandbox Docker Memory Limits
# Controls memory available to code execution containers
# Format: <number><unit> where unit is b, k, m, or g (e.g., 512m, 4g)
# Default: 2g (2 gigabytes)
SANDBOX_MEMORY_LIMIT=20g
SANDBOX_MEMORY_SWAP_LIMIT=6g

# Subprocess execution memory limit (for fallback mode)
# Used when EXECUTION_METHOD=subprocess
# Important: Set this to match or exceed SANDBOX_MEMORY_LIMIT for COBRApy/libSBML
SUBPROCESS_MEMORY_LIMIT_GB=30

# Code execution method: "docker-in-docker" or "subprocess"
# docker-in-docker: More isolated but requires Docker socket access
# subprocess: Direct execution, faster but less isolated
EXECUTION_METHOD=subprocess

# Docker-in-Docker Volume Mounting Configuration
# Host path to shared uploads directory for nested container file access
# Nested containers in Docker-in-Docker mode need the absolute host path
# to mount volumes correctly (not the container's internal path)
#
# Common paths:
#   Azure VM: /home/azureuser/codeworkspace/adept-extended-2025-11-07/data/uploaded_files
#   AWS EC2: /data/workspace/adept-agentic-framework-extended/data/shared_uploads
#   Local: /path/to/your/project/data/uploaded_files
#
# Leave empty to auto-detect based on environment
HOST_SHARED_UPLOADS_PATH=

# ===== Presigned URL Configuration =====
# HMAC secret for signing presigned file download URLs
# CRITICAL: Set a strong secret in production (min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PRESIGNED_URL_SECRET=change-this-in-production-use-secrets-token-urlsafe-32-minimum

# ===== Storage Quota Management =====
# High water mark system to prevent disk exhaustion from ephemeral tool outputs
# and uploaded files. Implements graduated thresholds with automatic cleanup.
#
# STORAGE_QUOTA_GB: Hard limit per user (default 5GB)
#   - 0-4GB: Normal operation (green zone)
#   - 4-5GB: Warning zone (yellow zone - user notified)
#   - >5GB: Hard limit (red zone - writes rejected)
STORAGE_QUOTA_GB=50

# STORAGE_WARNING_GB: Warning threshold (default 4GB)
#   - Triggers user notification when quota approaching
#   - Logged to orchestration service for monitoring
STORAGE_WARNING_GB=4

# BROWSER_CACHE_LIMIT_MB: Low water mark for browser cache optimization (default 100MB)
#   - Files below this threshold may be cached by browser
#   - Ephemeral files larger than this use presigned URLs
BROWSER_CACHE_LIMIT_MB=100

# EPHEMERAL_FILE_TTL_DAYS: Auto-delete ephemeral files after N days (default 7)
#   - Tool outputs and sandbox plots stored in /ephemeral/{session_id}/
#   - Background cleanup task runs every 5 minutes
#   - Files older than TTL are automatically deleted
EPHEMERAL_FILE_TTL_DAYS=7

# CLEANUP_INTERVAL_MINUTES: Background cleanup frequency (default 5 minutes)
#   - How often to scan and delete expired ephemeral files
#   - Lower values = more frequent cleanup, higher CPU usage
CLEANUP_INTERVAL_MINUTES=5

# Tool output size thresholds for context window management
# Controls when large tool outputs are excluded from LLM context and saved to files
#
# TOOL_OUTPUT_SMALL_THRESHOLD: Full inclusion in context (default 5000 chars ~1250 tokens)
#   - Small outputs included completely in ToolMessage
#   - No truncation or file storage
TOOL_OUTPUT_SMALL_THRESHOLD=5000

# TOOL_OUTPUT_MEDIUM_THRESHOLD: Truncate but include summary (default 200000 = 200K chars ~50K tokens)
#   - Medium outputs truncated to keep first/last portions
#   - Summary included in context for LLM awareness
#   - Base64 plots are redirected to ephemeral storage by the base64 guard,
#     so this threshold does NOT need to accommodate them
#   - Session 93 fix: lowered from 5MB (caused 305K token context overflow)
TOOL_OUTPUT_MEDIUM_THRESHOLD=200000

# TOOL_OUTPUT_LARGE_THRESHOLD: Exclude from context, save to file (default 1000000 = 1MB ~250K tokens)
#   - Large outputs NEVER enter context window (prevents token exhaustion)
#   - Automatically saved to ephemeral storage with 7-day TTL
#   - LLM receives file_id reference for ReadFile/GeneratePresignedURL
#   - Session 93 fix: lowered from 20MB (way above any model's context limit)
TOOL_OUTPUT_LARGE_THRESHOLD=1000000

# Default time-to-live for presigned URLs (seconds)
PRESIGNED_URL_DEFAULT_TTL=3600    # 1 hour

# Maximum allowed time-to-live (seconds)
PRESIGNED_URL_MAX_TTL=86400       # 24 hours

# ===== Streamlit Configuration =====
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501

# Streamlit Cookie Encryption Key (minimum 32 characters)
# Used for session persistence via encrypted browser cookies
# Generate with: openssl rand -base64 32
COOKIE_ENCRYPTION_KEY=your-random-32-char-encryption-key-here-change-in-production

# ===== Database Configuration =====
DATABASE_URL=sqlite+aiosqlite:///./data/mcp_state.db

# ===== ChromaDB Configuration =====
# Path for ChromaDB persistent storage.
# If commented out or not set, state_manager.py will use a default (e.g., "./chroma_data").
# For in-memory ChromaDB (ephemeral, data lost on restart), use ":memory:".
CHROMA_DB_PATH=./data/persistent_chroma_db
# CHROMA_DB_PATH=:memory:

# ===== Shared File System Configuration =====
# Consistent UID/GID for file permissions across containers
#SHARED_UID=1000
#SHARED_GID=1000
SHARED_UPLOAD_DIR=/app/data/uploaded_files
RAGFLOW_DATA_DIR=/app/data/ragflow

# UID/GID Configuration for consistent file permissions across all services
# Set these to match your system user for proper file permissions on mounted volumes
# Note: Using DOCKER_UID/DOCKER_GID to avoid conflict with readonly UID shell variable
DOCKER_UID=1000  # User ID for all services (default: 1000)
DOCKER_GID=1000  # Group ID for all services (default: 1000)

# ===== Logging Configuration =====
LOGGING_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ===== RAGFlow Configuration =====
# RAGFlow API server for advanced RAG capabilities
RAGFLOW_API_KEY=your-secure-ragflow-api-key-here
RAGFLOW_LOG_LEVEL=INFO

# RAGFlow Embedding Configuration
RAGFLOW_EMBEDDING_MODEL=text-embedding-ada-002  # Or text-embedding-3-small for better quality
RAGFLOW_EMBEDDING_DIMENSION=1536  # 1536 for ada-002, 1536 for text-embedding-3-small

# RAGFlow Processing Configuration
# Reduced chunk sizes to prevent token limit errors (200,000 token budget)
RAGFLOW_MAX_CHUNK_SIZE=512  # Reduced from 1000 to handle large documents
RAGFLOW_CHUNK_OVERLAP=100  # Reduced from 200 for better token efficiency
RAGFLOW_MAX_CHUNKS_PER_DOCUMENT=500  # Hard limit to prevent token overflow
RAGFLOW_AUTO_CHUNK_ADJUSTMENT=true  # Automatically adjust chunk size based on document size
RAGFLOW_ENABLE_OCR=true  # Enable OCR for scanned PDFs and images
RAGFLOW_ENABLE_TABLE_EXTRACTION=true  # Enable table extraction from documents

# RAGFlow Service URLs (internal Docker network)
RAGFLOW_API_URL=http://ragflow:9380
RAGFLOW_ELASTICSEARCH_URL=http://ragflow-elasticsearch:9200

# ===== Risk Mitigation & Feature Flags =====
# Gradual rollout configuration
ENABLE_RAGFLOW=false  # Master switch for RAGFlow integration (enabled by default)
RAG_BACKEND=auto  # RAG backend selection: ragflow, chromadb, pgvector, or auto (auto uses ENABLE_RAGFLOW to decide)
RAG_BACKEND_FALLBACK=true  # Enable fallback to ChromaDB if primary backend (RAGFlow or pgvector) is unavailable

# pgvector RAG Backend (dedicated PostgreSQL instance with vector extension)
# Uses a separate postgres_rag container to isolate vector workloads from orchestrator persistence.
# Connection URL defaults to postgres_rag service; override for external pgvector instances.
PGVECTOR_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER:-admin}:${POSTGRES_PASSWORD:-password}@postgres_rag:5432/agentic_rag
BM25_ENGINE=tsrank  # Full-text ranking engine: tsrank (native ts_rank_cd, default) or pg_search (ParadeDB true BM25)

# Fallback configuration
USE_CHROMADB_FALLBACK=true  # Maintain ChromaDB as fallback option
RAGFLOW_TIMEOUT_SECONDS=30  # Timeout before falling back to ChromaDB
RAGFLOW_MAX_RETRIES=3  # Number of retries before fallback

# Backend selection strategy
KB_BACKEND_STRATEGY=hybrid  # Options: ragflow_only, chromadb_only, hybrid, auto
KB_BACKEND_AUTO_ROUTING=true  # Auto-route based on document type

# Performance monitoring
ENABLE_RAGFLOW_METRICS=true  # Enable Prometheus metrics for RAGFlow
ENABLE_PERFORMANCE_LOGGING=true  # Log performance metrics for analysis
RAGFLOW_SLOW_QUERY_THRESHOLD_MS=500  # Log queries slower than this

# Testing & Validation
RAGFLOW_DRY_RUN_MODE=false  # Process documents but don't store (for testing)
ENABLE_PERMISSION_TESTING=true  # Extensive permission checks at startup
RAGFLOW_HEALTHCHECK_INTERVAL=60  # Seconds between health checks

# RAGFlow UI Configuration (for visual KB management)
RAGFLOW_UI_ENABLED=true  # Enable RAGFlow web UI for visual KB management
RAGFLOW_BASE_URL=http://localhost:9382  # External URL for RAGFlow UI (port 9382 to avoid conflicts)

# RAGFlow OIDC/Keycloak Integration
RAGFLOW_CLIENT_SECRET=ragflow-secret-change-me  # IMPORTANT: Change in production
RAGFLOW_OIDC_CLIENT_ID=ragflow-ui
RAGFLOW_OIDC_ISSUER=http://keycloak:8180/realms/master
RAGFLOW_OIDC_REDIRECT_URI=http://localhost:9382/auth/callback
RAGFLOW_OIDC_SCOPE="openid profile email groups"
RAGFLOW_OIDC_USER_CLAIM=preferred_username
RAGFLOW_OIDC_GROUPS_CLAIM=groups
RAGFLOW_ALLOWED_GROUPS=notebook-users,admin

# Session Synchronization
ENABLE_RAGFLOW_UI_SYNC=true  # Sync sessions between Streamlit and RAGFlow UI
RAGFLOW_SYNC_INTERVAL=300  # Sync interval in seconds (5 minutes)

# RAGFlow Access Control
RAGFLOW_ROLLOUT_PERCENTAGE=100  # Percentage of requests to route to RAGFlow (0-100)
RAGFLOW_ENABLED_USERS=paul,admin,notebook  # Comma-separated list of user IDs for early access
RAGFLOW_ENABLED_SESSIONS=  # Comma-separated list of session IDs for testing

# RAGFlow Backend Services Configuration (v0.8.0 uses MySQL not PostgreSQL)
RAGFLOW_MYSQL_ROOT_PASSWORD=ragflow_root_secure  # MySQL root password
RAGFLOW_MYSQL_DATABASE=ragflow  # Database name for RAGFlow
RAGFLOW_MYSQL_USER=ragflow  # MySQL user for RAGFlow
RAGFLOW_MYSQL_PASSWORD=ragflow  # MySQL password (change in production!)
RAGFLOW_REDIS_PASSWORD=ragflow_redis_secure  # Redis password for RAGFlow
RAGFLOW_MINIO_ROOT_USER=ragflow_admin  # MinIO admin user (optional)
RAGFLOW_MINIO_ROOT_PASSWORD=ragflow_minio_secure  # MinIO admin password (optional)

# ===== Web Search Configuration =====
# Web search API keys and configurations for various providers.
# These are used by the WebSearchAgent and other components that require web search capabilities.
BRAVE_SEARCH_API_KEY=YOUR_BRAVE_API_KEY_HERE  # TODO: Add your own. Required for Brave Search
BRAVE_SEARCH_API_BASE=https://api.brave.com/search/v1  # Base URL for Brave Search API
GOOGLE_SEARCH_API_KEY=YOUR_GOOGLE_API_KEY_HERE  # TODO: Add your own. Required for Google Search
GOOGLE_SEARCH_API_BASE=https://www.googleapis.com/customsearch/v1  # Base URL for Google Search API
GOOGLE_SEARCH_CX=YOUR_GOOGLE_CX_HERE  # Custom Search Engine ID
BING_SEARCH_API_KEY=YOUR_BING_API_KEY_HERE  # TODO: Add your own. Required for Bing Search
BING_SEARCH_API_BASE=https://api.bing.microsoft.com/v7.0/search  # Base URL for Bing Search API
DUCKDUCKGO_SEARCH_API_BASE=https://api.duckduckgo.com  # Base URL for DuckDuckGo Search API
DUCKDUCKGO_SEARCH_API_KEY=YOUR_DUCKDUCKGO_API_KEY_HERE  # TODO: Add your own. Required for DuckDuckGo Search

# ===== GitHub/GitLab Integration Configuration =====
# GitHub Access Token (for GitXRay to avoid rate limiting)
GH_ACCESS_TOKEN_GITXRAY=ghp_YOUR_GITHUB_TOKEN_HERE  # TODO: Add your own. Required for GitXRay
# GitLab Integration
GITLAB_API_TOKEN=glpat-YOUR_GITLAB_TOKEN_HERE  # Required for GitLab integration
GITLAB_INSTANCE_URL=https://gitlab.com  # Optional: Specify if you want to target a specific GitLab instance
# GITLAB_PROJECT_ID=your_gitlab_project_id  # Optional: Specify if you want to target a specific project
# GITLAB_PROJECT_NAME=your_gitlab_project_name  # Optional: Specify if you want to target a specific project by name

# ===== Google Vertex AI Configuration =====
# VERTEXAI_PROJECT=your_gcp_project_id  # Required
# VERTEXAI_LOCATION=your_gcp_region  # Required, e.g., us-central1

# ===== Groq (XAI) Configuration =====
# GROQ_API_KEY=pk-your_groq_api_key  # Required

# ================================================================================
# APPENDIX: Environment Variables Configuration Guide
# ================================================================================
#
# This file contains all configuration options for the ADEPT Extended Platform.
# Copy this file to .env and update with your specific values.
#
# SECTIONS OVERVIEW:
# -----------------
#
# 1. CORE SERVICES (Lines 1-33)
#    - Keycloak authentication (admin credentials, realm config)
#    - PostgreSQL database (credentials, connection settings)
#    - Redis cache configuration
#    - Gateway and registry service URLs
#
# 2. LLM CONFIGURATION (Lines 35-110)
#    - OpenAI API settings (key, model, embeddings)
#    - Azure OpenAI configuration
#    - AWS Bedrock settings for multi-model support
#    - Anthropic Claude configuration
#    - LLM purpose routing (coding_agent, agent_main)
#
# 3. MCP TOOL SERVERS (Lines 112-114)
#    - Sandbox MCP server URL for code execution
#    - HPC MCP server settings
#    - General MCP server configuration
#
# 4. SANDBOX EXECUTION (Lines 116-152)
#    - Execution timeouts (DEFAULT, MAX, DOWNLOAD)
#    - Memory limits (Docker and subprocess modes)
#    - Execution method (docker-in-docker vs subprocess)
#    - Volume mounting configuration (HOST_SHARED_UPLOADS_PATH)
#    - Security settings
#
# 5. STREAMLIT UI (Lines 154-159)
#    - Server address and port
#    - Frontend authentication settings
#
# 6. OBSERVABILITY (Lines 161-183)
#    - Langfuse tracing configuration
#    - Metrics and monitoring settings
#    - Performance tracking
#
# 7. RAG BACKENDS (Lines 185-249)
#    - RAGFlow configuration (embeddings, chunking, processing)
#    - ChromaDB fallback settings
#    - Backend selection strategy
#    - Performance monitoring
#    - OIDC integration for RAGFlow UI
#
# 8. EXTERNAL INTEGRATIONS (Lines 251-287)
#    - Web search APIs (Brave, Google, Bing, DuckDuckGo)
#    - GitHub/GitLab tokens
#    - Cloud provider configurations
#
# IMPORTANT CONFIGURATION NOTES:
# ------------------------------
#
# SANDBOX CONFIGURATION:
# - Set EXECUTION_METHOD to "docker-in-docker" for maximum isolation
# - Configure HOST_SHARED_UPLOADS_PATH for your environment:
#   * Azure: /home/azureuser/codeworkspace/adept-extended-2025-11-07/data/uploaded_files
#   * AWS: /data/workspace/adept-agentic-framework-extended/data/shared_uploads
# - Increase timeouts for scientific computing (COBRApy needs 120+ seconds)
# - Set memory limits appropriately (30GB+ for large models)
#
# AUTHENTICATION:
# - Change all default passwords before production deployment
# - Configure Keycloak with proper realm and client settings
# - Enable OIDC for RAGFlow UI integration
#
# LLM PROVIDERS:
# - At least one LLM provider must be configured
# - AWS Bedrock recommended for multi-model support
# - Configure purpose-specific models (coding_agent uses Opus by default)
#
# RAG CONFIGURATION:
# - Choose between RAGFlow and ChromaDB backends
# - Configure chunking sizes based on your document types
# - Enable fallback for high availability
#
# MONITORING:
# - Enable Langfuse for production observability
# - Configure appropriate log levels
# - Set up performance thresholds
#
# ================================================================================
