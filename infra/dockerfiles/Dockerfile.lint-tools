# infra/dockerfiles/Dockerfile.lint-tools
# Container for code quality and linting tools
# Purpose: Run black, ruff, mypy, isort checks in isolated environment
# Build: docker build -f infra/dockerfiles/Dockerfile.lint-tools -t agentic-framework-lint-tools:latest .

ARG DEPS_BASE_IMAGE=agentic-framework-deps-base:latest
FROM ${DEPS_BASE_IMAGE}

# USER appuser inherited from base image

WORKDIR /app

# Install linting tools via pip
# Versions synced with host conda adept-session env (2026-05-16)
RUN pip install --no-cache-dir \
    black==26.3.1 \
    ruff==0.15.12 \
    mypy==1.20.2 \
    isort==8.0.1 \
    vulture==2.16 \
    types-requests==2.31.0.10 \
    types-redis==4.6.0.11

# Set Python path for module resolution
ENV PYTHONPATH=/app/src

# Default command: show help
CMD ["echo", "Use specific linting commands via Makefile targets"]
