# =============================================================================
# AWS MCP Server Manager — Environment Configuration
# =============================================================================
# Copy to .env and fill in values:  cp .env.example .env

# ---------------------------------------------------------------------------
# IAM User Credentials (STS calls ONLY — never exposed to subprocesses)
# ---------------------------------------------------------------------------
# This IAM user needs ONLY sts:AssumeRole permission on AWS_MCP_STS_ROLE_ARN.
# Actual AWS service permissions are on the assumed role, not this user.
AWS_MCP_AWS_ACCESS_KEY_ID=
AWS_MCP_AWS_SECRET_ACCESS_KEY=
AWS_MCP_AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# STS AssumeRole Configuration
# ---------------------------------------------------------------------------
# The role that subprocesses will assume for actual AWS API calls.
# This role needs permissions for the AWS services you want to use
# (S3, DynamoDB, Lambda, etc.).
AWS_MCP_STS_ROLE_ARN=
AWS_MCP_STS_SESSION_DURATION=3600
# Optional: for cross-account assume role
AWS_MCP_STS_EXTERNAL_ID=

# ---------------------------------------------------------------------------
# Meta-Server Configuration
# ---------------------------------------------------------------------------
AWS_MCP_PORT=8003
AWS_MCP_PROXY_PORT=9830
AWS_MCP_PROXY_HTTPS_PORT=9831
AWS_MCP_SUBPROCESS_TIMEOUT=120
AWS_MCP_MAX_LOADED_SERVERS=20

# ---------------------------------------------------------------------------
# TLS / Certificate Configuration
# ---------------------------------------------------------------------------
# For cross-host deployments, generate certs with:
#   AWS_MCP_HOST_IP=<routable-ip> make generate-certs
#
# This creates certs/ca.crt, certs/aws_mcp.crt, certs/aws_mcp.key
# Copy certs/ca.crt to the ADEPT host for trust store installation.
AWS_MCP_HOST_IP=
# Optional: extra DNS SANs (comma-separated)
AWS_MCP_EXTRA_DNS=
# Optional: extra IP SANs (comma-separated)
AWS_MCP_EXTRA_IPS=

# ---------------------------------------------------------------------------
# STS Credential Refresh
# ---------------------------------------------------------------------------
# Refresh credentials this many seconds before expiry (default: 300 = 5 min)
AWS_MCP_STS_REFRESH_BUFFER=300
