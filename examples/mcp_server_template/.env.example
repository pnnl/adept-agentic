# {{DISPLAY_NAME}} Configuration
# =============================================
# All variables use {{NAME_UPPER}}_ prefix for namespace isolation

# ──────────────────────────────────────────────
# MCP Server Configuration
# ──────────────────────────────────────────────
{{NAME_UPPER}}_PORT={{MCP_PORT}}
{{NAME_UPPER}}_HOST=0.0.0.0
{{NAME_UPPER}}_WORKERS=4

# ──────────────────────────────────────────────
# Redis Configuration
# ──────────────────────────────────────────────
# Used for job state management and tool registration
{{NAME_UPPER}}_REDIS_URL=redis://{{NAME}}_redis:6379/0
{{NAME_UPPER}}_REDIS_PASSWORD=
{{NAME_UPPER}}_REDIS_DB=0
{{NAME_UPPER}}_REDIS_MAX_CONNECTIONS=50

# ──────────────────────────────────────────────
# Processing Configuration
# ──────────────────────────────────────────────
# Device for processing (cpu/cuda)
{{NAME_UPPER}}_DEVICE=cpu

# Model configuration
{{NAME_UPPER}}_DEFAULT_MODEL=default
{{NAME_UPPER}}_MODEL_CACHE_DIR=/app/data/models

# Batch processing
{{NAME_UPPER}}_DEFAULT_BATCH_SIZE=16
{{NAME_UPPER}}_MAX_BATCH_SIZE=128

# Timeouts (seconds)
{{NAME_UPPER}}_PROCESSING_TIMEOUT=3600
{{NAME_UPPER}}_JOB_TTL=86400

# ──────────────────────────────────────────────
# Data Directories
# ──────────────────────────────────────────────
# All paths are container-internal (mapped via volumes)
{{NAME_UPPER}}_INPUT_DIR=/app/data/input
{{NAME_UPPER}}_OUTPUT_DIR=/app/data/output
{{NAME_UPPER}}_RESULTS_DIR=/app/data/results
{{NAME_UPPER}}_MODELS_DIR=/app/data/models

# ──────────────────────────────────────────────
# Logging Configuration
# ──────────────────────────────────────────────
{{NAME_UPPER}}_LOG_LEVEL=INFO
{{NAME_UPPER}}_LOG_FORMAT=json
{{NAME_UPPER}}_LOG_FILE=/app/logs/{{NAME}}_mcp.log

# ──────────────────────────────────────────────
# ADEPT Integration
# ──────────────────────────────────────────────
# ADEPT Redis for tool registration (may differ from job Redis)
ADEPT_REDIS_URL=redis://redis:6379/0

# ADEPT Agent Gateway (for A2A communication)
ADEPT_GATEWAY_URL=http://agent_gateway:8081

# Session configuration
{{NAME_UPPER}}_SESSION_ISOLATION=true
{{NAME_UPPER}}_SESSION_CLEANUP_ENABLED=true
{{NAME_UPPER}}_SESSION_CLEANUP_INTERVAL=3600

# ──────────────────────────────────────────────
# Tool Registration
# ──────────────────────────────────────────────
# MCP server URL for tool registration (used by register script)
{{NAME_UPPER}}_MCP_URL=http://{{NAME}}_mcp_server:{{MCP_PORT}}

# Tool metadata
{{NAME_UPPER}}_TOOL_PREFIX={{NAME}}_
{{NAME_UPPER}}_TOOL_ACL=[]
{{NAME_UPPER}}_TOOL_COUNT={{TOOL_COUNT}}

# ──────────────────────────────────────────────
# Performance Tuning
# ──────────────────────────────────────────────
# Uvicorn worker processes
{{NAME_UPPER}}_UVICORN_WORKERS=4

# Worker lifecycle
{{NAME_UPPER}}_WORKER_MAX_REQUESTS=1000
{{NAME_UPPER}}_WORKER_MAX_REQUESTS_JITTER=50

# Connection limits
{{NAME_UPPER}}_MAX_CONCURRENT_REQUESTS=100
{{NAME_UPPER}}_REQUEST_TIMEOUT=300

# ──────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────
# Framework-injected security context (read-only in tools)
{{NAME_UPPER}}_REQUIRE_SESSION_ID=true
{{NAME_UPPER}}_REQUIRE_USER_CONTEXT=false

# ──────────────────────────────────────────────
# Development/Debug
# ──────────────────────────────────────────────
{{NAME_UPPER}}_DEBUG=false
{{NAME_UPPER}}_RELOAD=false
{{NAME_UPPER}}_PROFILE=false

# Test configuration (for test containers)
{{NAME_UPPER}}_TEST_MODE=false
{{NAME_UPPER}}_TEST_REDIS_DB=15
