# Minimal NGINX configuration to test basic functionality
server {
    listen 443 ssl;
    http2 on;
    server_name api.agentic.local localhost;

    # SSL configuration
    ssl_certificate /etc/nginx/certs/api.agentic.local.crt;
    ssl_certificate_key /etc/nginx/certs/api.agentic.local.key;
    
    # Basic SSL settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Health check endpoint
    location /health {
        access_log off;
        return 200 "nginx-proxy healthy\n";
        add_header Content-Type text/plain;
    }

    # Simple proxy test - just return status for now
    location /auth/ {
        return 200 "Auth endpoint available\n";
        add_header Content-Type text/plain;
    }

    location /v1/ {
        return 200 "API endpoint available\n"; 
        add_header Content-Type text/plain;
    }

    # Default location
    location / {
        return 404 '{"error": "Not Found"}';
        add_header Content-Type application/json;
    }
}

# HTTP redirect
server {
    listen 80;
    server_name api.agentic.local localhost;
    return 301 https://$server_name$request_uri;
}