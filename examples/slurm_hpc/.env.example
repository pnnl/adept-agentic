# =============================================================================
# Slurm HPC Example Stack — Environment Configuration
# =============================================================================
# Copy to .env and customize:  cp .env.example .env
# =============================================================================

# --- Slurm Version ---
SLURM_VERSION=25.11.2

# --- MySQL/MariaDB (Slurm accounting database) ---
MYSQL_DATABASE=slurm_acct_db
MYSQL_USER=slurm
MYSQL_PASSWORD=password

# --- Slurm REST API ---
# URL for slurmrestd (internal Docker network, NOT exposed to host)
SLURM_API_URL=http://slurmrestd:6820
# API version (auto-detected by bootstrap-jwt.sh, or set manually)
SLURM_API_VERSION=v0.0.41
# SSL verification (false for internal Docker network)
SLURM_VERIFY_SSL=false
# Request timeout in seconds
SLURM_TIMEOUT=30

# --- JWT Authentication (populated by bootstrap-jwt.sh) ---
# Base64-encoded HMAC key for on-the-fly token generation (preferred)
SLURM_JWT_KEY=
# Static JWT token (fallback, 24h expiry)
SLURM_SERVICE_JWT=
# Username for JWT token claims
SLURM_SERVICE_USER=root

# --- Port Mappings ---
# MCP server host port (container always listens on 8002)
SLURM_MCP_PORT=8002
# Nginx proxy host port (container listens on 80)
SLURM_PROXY_PORT=9820
# Nginx proxy HTTPS host port (container listens on 443, only active when certs present)
SLURM_PROXY_HTTPS_PORT=9821

# --- TLS / HTTPS (optional, for cross-host deployments) ---
# Protocol for tool registration (http or https)
SLURM_PROTO=http
# Host IP for certificate SAN (required for generate-certs)
# SLURM_HOST_IP=
# CA cert path for curl verification
SLURM_CA_CERT=./certs/ca.crt

# --- ADEPT Integration ---
# Admin credentials for tool registration
ADMIN_USER=admin
ADMIN_PASS=admin

# --- OIDC Authentication (optional, requires --profile oidc) ---
# Enable OIDC-protected nginx proxy
SLURM_OIDC_ENABLED=false
# Keycloak OIDC issuer URL
SLURM_OIDC_ISSUER_URL=http://keycloak:8180/realms/master
# Keycloak client for slurm_hpc
SLURM_OIDC_CLIENT_ID=slurm-hpc-client
SLURM_OIDC_CLIENT_SECRET=
# Cookie secret for oauth2_proxy (generate with: python -c "import secrets; print(secrets.token_hex(16))")
SLURM_OIDC_COOKIE_SECRET=

# --- SPIFFE/SPIRE Workload Identity (optional, requires --profile spire) ---
# Enable SPIFFE JWT-SVID authentication to slurmrestd
SPIFFE_ENABLED=false

# --- Globus Identity Mapping ---
# Path to identity mapping file (Globus/ADEPT user -> Slurm user)
SLURM_IDENTITY_MAP=/app/config/identity_map.json
