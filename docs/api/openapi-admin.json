{
  "openapi": "3.1.0",
  "info": {
    "title": "ADEPT Agentic Framework Admin API",
    "version": "1.0.20260601",
    "description": "Administrative API for the ADEPT Orchestration Service. Requires 'admin' role in JWT groups claim.",
    "contact": {
      "name": "ADEPT Platform Engineering Team",
      "url": "https://github.com/pnnl/adept-agentic"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8084",
      "description": "Orchestration Service (internal network only)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Tool Management",
      "description": "Register and manage external MCP/HTTP tools"
    },
    {
      "name": "Session Management",
      "description": "Session statistics and cleanup"
    },
    {
      "name": "Internal",
      "description": "Service-to-service communication"
    },
    {
      "name": "Health",
      "description": "Service health checks"
    }
  ],
  "paths": {
    "/internal/sessions/{session_id}/context": {
      "get": {
        "tags": [
          "Internal API"
        ],
        "summary": "Get Session Context",
        "description": "Get session context data.\n\nThis endpoint provides MCP servers with read access to session state\nwithout requiring direct imports or database connections.",
        "operationId": "get_session_context_internal_sessions__session_id__context_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Session Context Internal Sessions  Session Id  Context Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Internal API"
        ],
        "summary": "Update Session Context",
        "description": "Update session context data.\n\nThis endpoint allows MCP servers to update session state\nwithout requiring direct database access.",
        "operationId": "update_session_context_internal_sessions__session_id__context_put",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "title": "Context Data"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Update Session Context Internal Sessions  Session Id  Context Put"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/sessions": {
      "post": {
        "tags": [
          "Internal API"
        ],
        "summary": "Create Session",
        "description": "Create a new session if it doesn't exist.\n\nThis endpoint allows MCP servers to ensure sessions exist\nbefore attempting to store context.",
        "operationId": "create_session_internal_sessions_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionContextRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Create Session Internal Sessions Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/sessions/{session_id}": {
      "get": {
        "tags": [
          "Internal API"
        ],
        "summary": "Get Session Info",
        "description": "Get basic session information.\n\nReturns whether the session has context loaded. For full context data,\nuse the /sessions/{session_id}/context endpoint.",
        "operationId": "get_session_info_internal_sessions__session_id__get",
        "parameters": [
          {
            "name": "session_id",
