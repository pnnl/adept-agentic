server {
    listen 80;
    server_name _;

    # Health check endpoint (local response — no backend call)
    location /health {
        access_log off;
        return 200 '{"status":"ok","service":"aws-mcp-manager-proxy"}';
        add_header Content-Type application/json;
    }

    # MCP endpoint (main traffic)
    location /mcp {
        proxy_pass http://${MCP_SERVER_HOST}:${MCP_SERVER_PORT}/mcp;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # HTTP/1.1 for chunked transfer (MCP SSE streaming)
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # SSE streaming configuration
        proxy_request_buffering off;
        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        proxy_buffering off;

        # Support large payloads
        client_max_body_size 50M;
    }

    # Catch-all
    location / {
        return 404 '{"error":"Not Found","detail":"Use /mcp or /health"}';
        add_header Content-Type application/json;
    }
}
