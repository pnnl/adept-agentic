# Dockerfile for NGINX Public Proxy
# Provides secure TLS termination and path-based routing for external clients
FROM nginx:alpine

# Install openssl for certificate generation
RUN apk add --no-cache openssl

# Create directories for certificates and configuration
RUN mkdir -p /etc/nginx/certs /etc/nginx/templates

# Copy NGINX configuration template and remove default config
COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf
COPY infra/nginx/api.local.conf.template /etc/nginx/templates/api.local.conf.template
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy certificate generation script
COPY infra/nginx/generate-certs.sh /usr/local/bin/generate-certs.sh
RUN chmod +x /usr/local/bin/generate-certs.sh

# Copy startup script
COPY infra/nginx/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Create nginx user and set permissions
RUN adduser -D -s /bin/sh nginx || true
RUN chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx/certs

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/health || exit 1

# Expose ports
EXPOSE 80 443

# Use custom entrypoint for certificate management
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
