# Working NGINX configuration to test backend connectivity
server {
    listen 443 ssl;
    http2 on;
    server_name api.agentic.local localhost;

    # SSL configuration
    ssl_certificate /etc/nginx/certs/api.agentic.local.crt;
    ssl_certificate_key /etc/nginx/certs/api.agentic.local.key;
    
    # Basic SSL settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # NGINX self-health check
    location /health {
        access_log off;
        return 200 "nginx-proxy healthy\n";
        add_header Content-Type text/plain;
    }

    # Simple API test - minimal proxy
    location /v1/health {
        proxy_pass http://agent_gateway/health;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Default location
    location / {
        return 404 '{"error": "Not Found"}';
        add_header Content-Type application/json;
    }
}

# HTTP server
server {
    listen 80;
    server_name api.agentic.local localhost;
    
    location /health {
        access_log off;
        return 200 "nginx-proxy healthy (http)\n";
        add_header Content-Type text/plain;
    }
    
    location / {
        return 301 https://$server_name$request_uri;
    }
}